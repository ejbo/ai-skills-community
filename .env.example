# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skills_community

# ─── Auth.js ──────────────────────────────────────────────
AUTH_SECRET=replace-me-with-a-random-32-byte-string
# Auth.js base URL. For a SUBPATH deploy it must be the full path to the auth API,
# INCLUDING /api/auth — e.g. https://cari.rnd.huawei.com/ai-community/api/auth
# (NOT just /community). @auth/core matches the request path against this and builds
# the SSO callback as <AUTH_URL>/callback/huawei. For local dev, http://localhost:3000
# is fine. Any deploy served over HTTPS must set an https:// URL here — the cookie
# Secure/__Secure- posture is derived from this value's protocol (lib/auth.ts).
# The app also pins basePath from NEXT_BASE_PATH in code, so the two can't drift.
AUTH_URL=http://localhost:3000
# Subpath this app is served under (build-time). Empty = root/local. e.g. /community
NEXT_BASE_PATH=

# ─── Storage ──────────────────────────────────────────────
# Use 'local' for development, 'blob' for Vercel Blob in prod
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# Serve video bytes via nginx X-Accel-Redirect (kernel sendfile) instead of
# streaming through Node — enable only with the internal /_video/ nginx location.
VIDEO_X_ACCEL_REDIRECT=false
# Same offload for zone-media / vote-media / post-media / uploads. Both flags
# need their own internal nginx locations — leave OFF anywhere without nginx
# (local dev, the root deploy), or media returns empty bodies.
MEDIA_X_ACCEL_REDIRECT=false

# ── Concurrency + volume guards (capacity audit 2026-08) ───────────────────
# These have NON-ZERO DEFAULTS and apply to EVERY deploy, including local dev —
# listed here so they are not a surprise:
#   MEDIA_JOB_CONCURRENCY  1     ffmpeg faststart remuxes that may run at once
#   SUBTITLE_CONCURRENCY   1     whisper ASR jobs that may run at once
#   MIN_FREE_DISK_MB       2048  refuse uploads below this much free space; 0 = off
#   MAX_UPLOAD_MB          2048  per-file volume-safety ceiling; 0 = unlimited
# MAX_UPLOAD_MB is NOT the 短视频/投票 product decision (which is "no cap") — it
# is the size past which the box gives up anyway. Set it to 0 to restore that.
MEDIA_JOB_CONCURRENCY=1
SUBTITLE_CONCURRENCY=1
MIN_FREE_DISK_MB=2048
MAX_UPLOAD_MB=2048
BLOB_READ_WRITE_TOKEN=

# ─── Huawei UniPortal SSO (optional) ──────────────────────
# Set ENABLE_SSO=true to expose the W3 login card. When false, the block below is
# unused and the site runs fully on email/password auth.
# Full deploy guide (registration, nginx, redirect_uri rule): docs/huawei-sso-deploy.md
# D2 reuse: set CLIENT_ID/SECRET to an existing registration whose 应用域名 covers
# your host — the callback below must be a subdirectory of that registered 应用域名.
ENABLE_SSO=false
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Informational only (Auth.js derives the real callback from AUTH_URL). This is the URL
# you register with Huawei: <AUTH_URL>/api/auth/callback/huawei
SSO_REDIRECT_URI=http://localhost:3000/api/auth/callback/huawei
SSO_AUTHORIZE_URL=https://uniportal.huawei.com/saaslogin1/oauth2/authorize
SSO_ACCESS_TOKEN_URL=https://uniportal.huawei.com/saaslogin1/oauth2/accesstoken
SSO_USERINFO_URL=https://uniportal.huawei.com/saaslogin1/oauth2/userinfo
SSO_SCOPE=base.profile
SSO_VERIFY_SSL=false

# ─── Outbound egress (proxy / TLS) ────────────────────────
# Not SSO-specific: this is how 知识库 URL 导入 and an external LLM reach the
# public internet from a box that has no direct route. Routing is per-host —
# PROXY_BYPASS hosts stay direct even when the proxy is on. See lib/net/proxy.ts.
USE_PROXY=false
HUAWEI_PROXY_HOST=proxyca.huawei.com    # host only — no scheme, no ":8080"
HUAWEI_PROXY_PORT=8080
# Defaults to localhost,127.0.0.1,::1,.huawei.com + RFC1918 when unset.
# PROXY_BYPASS=.huawei.com,10.0.0.0/8
# The corporate proxy TLS-intercepts. PROXY_CA_FILE is the only CA option that
# works from .env (NODE_EXTRA_CA_CERTS must be a systemd Environment= line —
# Node reads it before Next loads this file). PROXY_TLS_INSECURE is the fallback.
# PROXY_CA_FILE=/etc/ssl/certs/huawei-ca-bundle.pem
PROXY_TLS_INSECURE=false
INTERNAL_TLS_INSECURE=false

# ─── Initial Admin ────────────────────────────────────────
# On first startup, if no admin exists, this account is auto-created.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=changeme

# ─── Anthropic API (for Try It feature) ───────────────────
ANTHROPIC_API_KEY=

# ─── Seed sources ─────────────────────────────────────────
ANTHROPIC_SKILLS_REPO=https://github.com/anthropics/skills

# ─── Email (optional) ─────────────────────────────────────
# Email side of the notification system (comment replies, access requests/
# decisions, announcements — gated per-user in Settings → 通知).
# When SMTP_HOST/SMTP_FROM are unset, emails are silently skipped (in-app
# notifications still work). APP_URL is the public base URL used in email links.
# Test it live: 管理后台 → 公告 → "邮件 (SMTP) 诊断" surfaces the real send error.
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587            # 587 STARTTLS / 465 implicit-TLS (SMTP_SECURE=true) / 25 plaintext relay
SMTP_USER=              # omit user+pass to send unauthenticated
SMTP_PASS=
SMTP_FROM="Skills Community <no-reply@example.com>"
SMTP_SECURE=false       # true ONLY for port 465
SMTP_IGNORE_TLS=false   # true for a plaintext relay (e.g. port 25) with no STARTTLS
