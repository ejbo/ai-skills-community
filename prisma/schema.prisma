// Skills Community — Prisma schema
// 14 core tables covering users, auth, audit, skills, social, CLI tokens.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ─────────────────────────────────────────────────────────

enum AuthMethod {
  password
  huawei_sso
  both
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  handle              String     @unique
  displayName         String
  passwordHash        String?
  huaweiW3Id          String?    @unique
  // Real/company name from Huawei W3, captured on first SSO login. IMMUTABLE — never
  // editable by the user (displayName is the editable one); lets admins see who a
  // person really is even after they rename their display name.
  huaweiW3Name        String?
  authMethod          AuthMethod @default(password)
  avatarUrl           String?
  bio                 String?
  // 部门 / 研究所 — 引用自员工名单（/manage/employees），按工号自动同步；请勿手工维护。
  department          String?
  lab                 String?
  // 隐私账号：开启后对普通用户只显示昵称与头像（隐藏部门/研究所/@handle）；管理员始终可见全部。
  isPrivate           Boolean    @default(false)
  // 知识库阅读动态：关闭后不出现在文档的「正在阅读」名单里（计数不受影响）。
  showLibraryActivity Boolean    @default(true)
  // 个人主页板块可见性（/users/[handle]）：关闭后该板块仅本人与管理员可见。
  // 服务端裁剪 —— 关闭的板块数据不查询、不下发（同 isPrivate 的合同）。
  showProfileSkills   Boolean    @default(true)
  showProfileDocs     Boolean    @default(true)
  showProfilePosts    Boolean    @default(true)
  showProfileComments Boolean    @default(true)
  showProfileShelf    Boolean    @default(true)
  showProfileEvents   Boolean    @default(true)
  isAdmin             Boolean    @default(false)
  isActive            Boolean    @default(true)
  canPublishSkills    Boolean    @default(true)
  canRemix            Boolean    @default(true)
  canUseCli           Boolean    @default(true)
  dailyDownloadLimit  Int?
  dailyPublishLimit   Int?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  lastSeenAt          DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  skills          Skill[]              @relation("AuthoredSkills")
  reviews         Review[]
  favorites       Favorite[]
  likes           Like[]
  subscriptions   Subscription[]
  loginEvents     LoginEvent[]
  pageVisits      PageVisit[]
  adminActions    AdminLog[]           @relation("AdminActor")
  cliTokens       CliToken[]
  downloads       Download[]
  accessRequests  SkillAccessRequest[] @relation("AccessRequester")
  accessDecisions SkillAccessRequest[] @relation("AccessDecider")
  employeeEntries EmployeeDirectory[]  @relation("EmployeeEntryCreator")

  // ── Video board back-relations (virtual; no SQL columns on User) ──
  uploadedVideos    Video[]            @relation("UploadedVideos")
  guestVideos       Video[]            @relation("GuestVideos")
  videoViews        VideoView[]
  videoLikes        VideoLike[]
  videoFavorites    VideoFavorite[]
  videoComments     VideoComment[]
  videoCommentLikes VideoCommentLike[]

  // ── Notifications back-relations (virtual; no SQL columns on User) ──
  notificationsReceived  Notification[]          @relation("NotifRecipient")
  notificationsActed     Notification[]          @relation("NotifActor")
  authoredAnnouncements  Announcement[]          @relation("AuthoredAnnouncements")
  notificationPreference NotificationPreference?
  createdPacks           SkillPack[]             @relation("CreatedPacks")

  // ── Feedback back-relations (virtual; no SQL columns on User) ──
  feedbacks        Feedback[]
  feedbackUpvotes  FeedbackUpvote[]
  feedbackComments FeedbackComment[]

  // ── Discussion back-relations (virtual; no SQL columns on User) ──
  posts             Post[]             @relation("AuthoredPosts")
  postLikes         PostLike[]
  postComments      PostComment[]
  postCommentLikes  PostCommentLike[]
  discussionTopics  DiscussionTopic[]
  discussionUpvotes DiscussionUpvote[]
  discussionReplies DiscussionReply[]

  // ── Events back-relations (virtual; no SQL columns on User) ──
  authoredEvents Event[] @relation("AuthoredEvents")

  // ── Library back-relations (virtual; no SQL columns on User) ──
  libraryDocs            LibraryDoc[]
  libraryShelf           LibraryShelfItem[]
  libraryLikes           LibraryLike[]
  libraryProgress        LibraryProgress[]
  libraryHighlights      LibraryHighlight[]
  libraryViews           LibraryView[]
  libraryChatMessages    LibraryChatMessage[]
  libraryComments        LibraryComment[]
  libraryRatings         LibraryRating[]
  libraryNoteReplies     LibraryNoteReply[]
  libraryAccessRequests  LibraryAccessRequest[] @relation("LibraryAccessRequester")
  libraryAccessDecisions LibraryAccessRequest[] @relation("LibraryAccessDecider")

  @@index([handle])
  @@index([email])
  @@index([isAdmin])
  @@index([lastLoginAt])
}

enum LoginMethod {
  password
  huawei_sso
}

model LoginEvent {
  id            String      @id @default(cuid())
  userId        String?
  method        LoginMethod
  ip            String?
  userAgent     String?
  success       Boolean
  failureReason String?
  createdAt     DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([success])
}

model PageVisit {
  id        String   @id @default(cuid())
  userId    String
  path      String
  pageName  String?
  referrer  String?
  userAgent String?
  ip        String?
  visitedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, visitedAt])
  @@index([path, visitedAt])
}

model AdminLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String?
  targetId    String?
  details     Json?
  ip          String?
  createdAt   DateTime @default(now())

  adminUser User @relation("AdminActor", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ─── Taxonomy ────────────────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  parentId    String?
  sortOrder   Int     @default(0)

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  skills   Skill[]

  @@index([parentId])
}

model Tag {
  id         String @id @default(cuid())
  slug       String @unique
  name       String
  usageCount Int    @default(0)

  skills SkillTag[]
}

model SkillTag {
  skillId String
  tagId   String

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([skillId, tagId])
  @@index([tagId])
}

// ─── Skills ──────────────────────────────────────────────────────────────

enum SourceType {
  internal
  external
  curated
}

enum SkillFormat {
  bundle
  structured
}

enum SkillStatus {
  draft
  published
  archived
}

enum SkillVisibility {
  public // discoverable + downloadable by any logged-in user (current behavior)
  restricted // discoverable, but file contents + download gated behind an approved access request
  private // only the owner (and admins, in the admin panel) can see / edit / download / test
}

enum AccessRequestStatus {
  pending
  approved
  rejected
  revoked
}

model Skill {
  id                String          @id @default(cuid())
  slug              String          @unique
  name              String
  summary           String
  descriptionMd     String          @default("")
  authorId          String
  categoryId        String?
  sourceType        SourceType      @default(external)
  skillFormat       SkillFormat     @default(bundle)
  status            SkillStatus     @default(draft)
  visibility        SkillVisibility @default(public)
  currentVersionId  String?         @unique
  structuredPayload Json?
  externalSourceUrl String?
  license           String?         @default("MIT")
  homepageUrl       String?
  repoUrl           String?
  downloadCount     Int             @default(0)
  favoriteCount     Int             @default(0)
  likeCount         Int             @default(0)
  reviewCount       Int             @default(0)
  subscriberCount   Int             @default(0)
  remixCount        Int             @default(0)
  avgRating         Float           @default(0)
  trendingScore     Float           @default(0)
  tokenCostEstimate Int             @default(0)
  triggerHitRate    Float?
  forkedFromId      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  author         User          @relation("AuthoredSkills", fields: [authorId], references: [id], onDelete: Cascade)
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  currentVersion SkillVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  forkedFrom     Skill?        @relation("Forks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks          Skill[]       @relation("Forks")

  versions       SkillVersion[]       @relation("AllVersions")
  tags           SkillTag[]
  downloads      Download[]
  reviews        Review[]
  favorites      Favorite[]
  likes          Like[]
  subscriptions  Subscription[]
  accessRequests SkillAccessRequest[]
  comparison     SkillComparison?
  packItems      SkillPackItem[]

  @@index([status, sourceType])
  @@index([visibility, status])
  @@index([categoryId])
  @@index([authorId])
  @@index([trendingScore])
  @@index([createdAt])
  @@index([forkedFromId])
}

// Per-skill access requests for `restricted` skills. One row per (skill, user):
// re-applying after a rejection/revocation mutates the existing row back to `pending`.
// Access is granted iff status === approved (ongoing, revocable).
model SkillAccessRequest {
  id           String              @id @default(cuid())
  skillId      String
  userId       String // applicant
  status       AccessRequestStatus @default(pending)
  message      String? // applicant note (申请理由)
  decidedById  String? // author or admin who approved / rejected / revoked
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  skill     Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user      User  @relation("AccessRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("AccessDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([skillId, userId])
  @@index([skillId, status])
  @@index([userId, status])
}

// Author-generated, editable "install vs not" comparison shown on a skill's
// Comparison tab. One row per skill. The `example` JSON holds a real dual-run
// ({ taskPrompt, withOutput, withoutOutput }); `bodyMd` is the structured
// analysis report a visitor reads. Generated/edited in the author-side workshop.
model SkillComparison {
  id                    String   @id @default(cuid())
  skillId               String   @unique
  status                String   @default("draft") // draft | published
  bodyMd                String?
  example               Json?
  guidancePrompt        String?
  model                 String?
  generatedForVersionId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

enum VersionStatus {
  draft
  published
  yanked
}

model SkillVersion {
  id             String        @id @default(cuid())
  skillId        String
  version        String
  major          Int
  minor          Int
  patch          Int
  changelogMd    String        @default("")
  storageUrl     String?
  contentInline  String?
  manifestJson   Json?
  fileCount      Int           @default(0)
  totalBytes     Int           @default(0)
  checksumSha256 String?
  status         VersionStatus @default(draft)
  tokenCost      Int           @default(0)
  downloadCount  Int           @default(0)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())

  skill           Skill          @relation("AllVersions", fields: [skillId], references: [id], onDelete: Cascade)
  currentForSkill Skill?         @relation("CurrentVersion")
  downloads       Download[]
  reviews         Review[]
  subscriptions   Subscription[]
  files           SkillFile[]

  @@unique([skillId, version])
  @@index([skillId, major, minor, patch])
  @@index([status])
}

model SkillFile {
  id        String  @id @default(cuid())
  versionId String
  path      String
  size      Int
  isText    Boolean @default(true)
  content   String?
  truncated Boolean @default(false)

  version SkillVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, path])
  @@index([versionId])
}

// ─── Skill Packs（合集包）──────────────────────────────────────────────────
// Admin-curated bundles of skills installable with one CLI command
// (`skills install pack:<slug>`). A skill can belong to many packs.

model SkillPack {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  summary       String   @default("")
  descriptionMd String   @default("")
  icon          String   @default("")
  isPublished   Boolean  @default(false)
  sortOrder     Int      @default(0)
  installCount  Int      @default(0)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User?           @relation("CreatedPacks", fields: [createdById], references: [id], onDelete: SetNull)
  items     SkillPackItem[]

  @@index([isPublished, sortOrder])
}

model SkillPackItem {
  id        String @id @default(cuid())
  packId    String
  skillId   String
  sortOrder Int    @default(0)

  pack  SkillPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  skill Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([packId, skillId])
  @@index([skillId])
}

// ─── Feedback（意见反馈）──────────────────────────────────────────────────
// GitHub-issue-style feedback: users post, everyone comments (2-level flat
// threads, same shape as VideoComment) and upvotes; admins set the status.

enum FeedbackCategory {
  feature // 功能建议
  bug // 问题反馈
  other // 其他
}

enum FeedbackStatus {
  open // 待处理
  planned // 已计划
  in_progress // 处理中
  done // 已完成
  declined // 不采纳
}

enum FeedbackCommentStatus {
  visible
  deleted // tombstone: kept to preserve thread shape, body wiped
}

model Feedback {
  id           String           @id @default(cuid())
  authorId     String
  title        String
  bodyMd       String           @default("")
  category     FeedbackCategory @default(other)
  status       FeedbackStatus   @default(open)
  upvoteCount  Int              @default(0)
  commentCount Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  author   User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  upvotes  FeedbackUpvote[]
  comments FeedbackComment[]

  @@index([status, createdAt])
  @@index([upvoteCount])
  @@index([authorId])
}

model FeedbackUpvote {
  userId     String
  feedbackId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@id([userId, feedbackId])
  @@index([feedbackId])
}

model FeedbackComment {
  id         String                @id @default(cuid())
  feedbackId String
  authorId   String
  // Always points at a TOP-LEVEL comment (2-level flat threads); reply-to-reply
  // routing uses a transient replyToId in the API, never stored.
  parentId   String?
  bodyMd     String
  status     FeedbackCommentStatus @default(visible)
  replyCount Int                   @default(0)
  createdAt  DateTime              @default(now())

  feedback Feedback          @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  author   User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   FeedbackComment?  @relation("FeedbackCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  FeedbackComment[] @relation("FeedbackCommentThread")

  @@index([feedbackId, createdAt])
  @@index([parentId])
}

// ─── Social ──────────────────────────────────────────────────────────────

enum DownloadClient {
  web
  cli
}

model Download {
  id         String         @id @default(cuid())
  skillId    String
  versionId  String?
  userId     String?
  client     DownloadClient @default(web)
  clientMeta Json?
  ipHash     String?
  via        String? // 'download' | 'raw' | 'install' | 'update' | 'try'
  userAgent  String?
  grantId    String? // SkillAccessRequest.id when this was a gated (restricted) download
  createdAt  DateTime       @default(now())

  skill   Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  version SkillVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([skillId, createdAt])
  @@index([skillId, userId])
  @@index([versionId, createdAt])
  @@index([userId])
  @@index([createdAt])
}

model Favorite {
  userId    String
  skillId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
}

model Like {
  userId    String
  skillId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
}

model Subscription {
  userId             String
  skillId            String
  installedVersionId String?
  createdAt          DateTime  @default(now())
  notifiedAt         DateTime?

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill            Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  installedVersion SkillVersion? @relation(fields: [installedVersionId], references: [id], onDelete: SetNull)

  @@id([userId, skillId])
  @@index([skillId])
}

model Review {
  id          String   @id @default(cuid())
  skillId     String
  versionId   String?
  authorId    String
  rating      Int
  bodyMd      String
  authorReply String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skill   Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  version SkillVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([skillId, authorId])
  @@index([skillId, createdAt])
}

// ─── CLI ─────────────────────────────────────────────────────────────────

model CliToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenHash   String
  tokenPrefix String
  scopes      String[]  @default([])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenPrefix])
}

model DeviceCode {
  deviceCode String    @id
  userCode   String    @unique
  userId     String?
  expiresAt  DateTime
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userCode])
  @@index([expiresAt])
}

// ─── Video board ───────────────────────────────────────────────────────────
// A self-contained YouTube/TikTok-style board. Every Video* model FKs ONLY to
// User or Video* — never Skill. Self-hosted videos live in object storage; the
// DB holds metadata + a URL. AI summary is cached on Video; chat is stateless.

enum VideoStatus {
  draft
  processing
  published
  unlisted
  archived
}

enum VideoVisibility {
  public
  unlisted
  private
}

enum VideoSourceType {
  admin_curated
  user_uploaded
  external_embed
}

enum VideoCommentStatus {
  visible
  hidden
  deleted
}

model VideoCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  coverKey    String?
  parentId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   VideoCategory?  @relation("VideoCategoryHierarchy", fields: [parentId], references: [id])
  children VideoCategory[] @relation("VideoCategoryHierarchy")
  videos   Video[]

  @@index([parentId])
  @@index([sortOrder])
}

model VideoTag {
  id         String            @id @default(cuid())
  slug       String            @unique
  name       String
  usageCount Int               @default(0)
  videos     VideoTagOnVideo[]

  @@index([usageCount])
}

model VideoTagOnVideo {
  videoId   String
  tagId     String
  createdAt DateTime @default(now())

  video Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag   VideoTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
  @@index([tagId])
}

model Video {
  id            String @id @default(cuid())
  slug          String @unique
  title         String
  summary       String @default("") // feed caption (≠ AI summary)
  descriptionMd String @default("")

  // Media (self-hosted, object storage; browser direct upload)
  videoKey    String?
  videoUrl    String?
  posterKey   String?
  posterUrl   String?
  previewKey  String? // optional dedicated hover-preview clip; falls back to first seconds of source
  previewUrl  String?
  mimeType    String  @default("video/mp4")
  sizeBytes   Int     @default(0)
  width       Int?
  height      Int?
  durationSec Int     @default(0)
  externalUrl String? // external_embed only (phase-2)

  // Status / classification
  status      VideoStatus     @default(draft)
  visibility  VideoVisibility @default(public)
  sourceType  VideoSourceType @default(admin_curated)
  uploaderId  String
  categoryId  String?
  language    String?
  featured    Boolean         @default(false)
  featuredAt  DateTime?
  publishedAt DateTime?

  // Interviewee ("AI 极客访谈"), all optional
  intervieweeName      String?
  intervieweeTitle     String?
  intervieweeOrg       String?
  intervieweeBio       String?
  intervieweeAvatarKey String?
  guestUserId          String?

  // Denormalized counters
  viewCount     Int   @default(0)
  likeCount     Int   @default(0)
  commentCount  Int   @default(0)
  favoriteCount Int   @default(0)
  trendingScore Float @default(0)

  // AI (cached summary columns; chat is stateless)
  transcriptText      String?
  aiSummaryMd         String?
  aiSummaryModel      String?
  aiSummaryAt         DateTime?
  aiSummarySourceHash String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  uploader  User              @relation("UploadedVideos", fields: [uploaderId], references: [id], onDelete: Cascade)
  guestUser User?             @relation("GuestVideos", fields: [guestUserId], references: [id], onDelete: SetNull)
  category  VideoCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags      VideoTagOnVideo[]
  comments  VideoComment[]
  likes     VideoLike[]
  favorites VideoFavorite[]
  views     VideoView[]

  @@index([status, visibility])
  @@index([publishedAt])
  @@index([categoryId])
  @@index([uploaderId])
  @@index([featured, publishedAt])
  @@index([trendingScore])
  @@index([createdAt])
}

model VideoComment {
  id         String             @id @default(cuid())
  videoId    String
  authorId   String
  parentId   String?
  bodyMd     String
  status     VideoCommentStatus @default(visible)
  likeCount  Int                @default(0)
  replyCount Int                @default(0)
  pinned     Boolean            @default(false)
  editedAt   DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  video   Video              @relation(fields: [videoId], references: [id], onDelete: Cascade)
  author  User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  VideoComment?      @relation("VideoCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies VideoComment[]     @relation("VideoCommentThread")
  likes   VideoCommentLike[]

  @@index([videoId, createdAt])
  @@index([parentId])
}

model VideoCommentLike {
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment VideoComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
}

model VideoLike {
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([videoId])
}

model VideoFavorite {
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([videoId])
}

model VideoView {
  id          String   @id @default(cuid())
  videoId     String
  userId      String?
  sessionHash String // sha256( (userId | ipHash) + videoId + UTC-day ) — day-bucket dedupe
  createdAt   DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([videoId, sessionHash])
  @@index([videoId])
}

// ─── Notifications & Announcements ────────────────────────────────────────

enum NotificationType {
  comment_reply // someone replied to your top-level video comment
  reply_reply // someone replied to your reply
  access_request // someone requested download access to your restricted skill
  access_decision // your access request was approved / rejected / revoked
  announcement // admin-published update announcement
}

// One row per recipient. title/body/link are rendered at creation time so the
// bell can show items without extra joins. payload carries optional extras.
model Notification {
  id          String           @id @default(cuid())
  recipientId String
  type        NotificationType
  actorId     String?
  title       String
  body        String?
  link        String?
  payload     Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipient User  @relation("NotifRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotifActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([actorId])
}

// Admin-published update announcement. publishedAt == null ⇒ draft.
model Announcement {
  id          String    @id @default(cuid())
  title       String
  bodyMd      String    @default("")
  publishedAt DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User @relation("AuthoredAnnouncements", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([publishedAt])
  @@index([createdById])
}

// ─── Discussion（讨论区）───────────────────────────────────────────────────
// Community hub: LinkedIn/HF-style feed posts (Post*) + Discourse-style forum
// topics (Discussion*). Self-contained like the video board: every model here
// FKs only to User or another Post*/Discussion* model — never Skill/Video.

enum PostMediaKind {
  image
  video // self-hosted upload, played inline in the feed
  video_link // external URL — rendered as a link card (intranet blocks iframes)
  file // pdf / ppt / doc attachment
}

enum PostCommentStatus {
  visible
  deleted // tombstone: kept to preserve thread shape, body wiped
}

model Post {
  id           String    @id @default(cuid())
  authorId     String
  bodyMd       String    @default("")
  pinned       Boolean   @default(false)
  likeCount    Int       @default(0)
  commentCount Int       @default(0)
  editedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author   User          @relation("AuthoredPosts", fields: [authorId], references: [id], onDelete: Cascade)
  media    PostMedia[]
  likes    PostLike[]
  comments PostComment[]

  @@index([pinned, createdAt])
  @@index([createdAt])
  @@index([authorId])
}

model PostMedia {
  id        String        @id @default(cuid())
  postId    String
  kind      PostMediaKind
  // Uploaded media stores the storage key + root-relative URL (withBasePath is
  // applied at render time); video_link stores the external URL, key stays "".
  key       String        @default("")
  url       String
  posterUrl String?
  name      String        @default("") // original filename (file) / link label
  mimeType  String        @default("")
  sizeBytes Int           @default(0)
  width     Int?
  height    Int?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

// LinkedIn-style reactions: one row per (user, post); `reaction` records which
// of the palette was chosen. Post.likeCount stays the TOTAL across all types.
enum PostReaction {
  like // 👍 赞
  celebrate // 👏 精彩
  support // 🤝 支持
  love // ❤️ 喜爱
  insightful // 💡 有启发
  funny // 😄 有趣
}

model PostLike {
  userId    String
  postId    String
  reaction  PostReaction @default(like)
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@index([postId, reaction])
}

model PostComment {
  id         String            @id @default(cuid())
  postId     String
  authorId   String
  // Always points at a TOP-LEVEL comment (2-level flat threads); reply-to-reply
  // routing uses a transient replyToId in the API, never stored.
  parentId   String?
  bodyMd     String
  status     PostCommentStatus @default(visible)
  likeCount  Int               @default(0)
  replyCount Int               @default(0)
  createdAt  DateTime          @default(now())

  post    Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  PostComment?      @relation("PostCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[]     @relation("PostCommentThread")
  likes   PostCommentLike[]

  @@index([postId, createdAt])
  @@index([postId, likeCount])
  @@index([parentId])
}

model PostCommentLike {
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
}

enum DiscussionCategory {
  tech // 技术交流
  qa // 问答求助
  share // 经验分享
  showcase // 成果展示
  general // 综合讨论（历史值，发帖入口已隐藏 — 分类聚焦 AI 技术）
  models // 模型与算法
  agents // Agent 与工具
  skills // Skill 开发
  research // 前沿研究
}

enum DiscussionReplyStatus {
  visible
  deleted // tombstone: kept to preserve thread shape, body wiped
}

model DiscussionTopic {
  id             String               @id @default(cuid())
  authorId       String
  title          String
  bodyMd         String               @default("")
  // Legacy single category — kept in sync with categories[0] so existing
  // indexes/sorts stay valid. New reads/filters use `categories`.
  category       DiscussionCategory   @default(general)
  // Multi-select主题 (1..3 picked in the composer).
  categories     DiscussionCategory[] @default([])
  pinned         Boolean              @default(false)
  locked         Boolean              @default(false)
  upvoteCount    Int                  @default(0)
  replyCount     Int                  @default(0)
  viewCount      Int                  @default(0)
  // Bumped on every reply — drives the default "最新回复" ordering.
  lastActivityAt DateTime             @default(now())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  author  User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  upvotes DiscussionUpvote[]
  replies DiscussionReply[]
  views   DiscussionTopicView[]
  media   TopicMedia[]

  @@index([category, lastActivityAt])
  @@index([pinned, lastActivityAt])
  @@index([lastActivityAt])
  @@index([upvoteCount])
  @@index([authorId])
}

// Forum-topic attachments — same shape/serving stack as PostMedia (uploads via
// /api/discussion/upload, bytes via /api/discussion/media/[...key]).
model TopicMedia {
  id        String        @id @default(cuid())
  topicId   String
  kind      PostMediaKind
  // Uploaded media stores the storage key + root-relative URL (withBasePath is
  // applied at render time); video_link stores the external URL, key stays "".
  key       String        @default("")
  url       String
  posterUrl String?
  name      String        @default("") // original filename (file) / link label
  mimeType  String        @default("")
  sizeBytes Int           @default(0)
  width     Int?
  height    Int?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  topic DiscussionTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, sortOrder])
}

model DiscussionTopicView {
  id          String   @id @default(cuid())
  topicId     String
  sessionHash String // sha256( (userId | ipHash) + topicId + UTC-day ) — day-bucket dedupe
  createdAt   DateTime @default(now())

  topic DiscussionTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, sessionHash])
  @@index([topicId])
}

model DiscussionUpvote {
  userId    String
  topicId   String
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic DiscussionTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@index([topicId])
}

model DiscussionReply {
  id         String                @id @default(cuid())
  topicId    String
  authorId   String
  // Always points at a TOP-LEVEL reply (2-level flat threads); reply-to-reply
  // routing uses a transient replyToId in the API, never stored.
  parentId   String?
  bodyMd     String
  status     DiscussionReplyStatus @default(visible)
  replyCount Int                   @default(0)
  createdAt  DateTime              @default(now())

  topic   DiscussionTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author  User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  DiscussionReply?  @relation("DiscussionReplyThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies DiscussionReply[] @relation("DiscussionReplyThread")

  @@index([topicId, createdAt])
  @@index([parentId])
}

// Per-user notification settings: per-category in-app toggle + "also email".
// Access request/decision emails default ON to preserve the existing behavior;
// the newer comment-reply / announcement emails default OFF (opt-in).
model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  inAppCommentReply   Boolean  @default(true)
  inAppAccessRequest  Boolean  @default(true)
  inAppAccessDecision Boolean  @default(true)
  inAppAnnouncement   Boolean  @default(true)
  emailCommentReply   Boolean  @default(false)
  emailAccessRequest  Boolean  @default(true)
  emailAccessDecision Boolean  @default(true)
  emailAnnouncement   Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── 员工名单（Employee Directory）─────────────────────────────────────────
// Admin-curated roster maintained at /manage/employees. Rows whose accountNumber
// (工号, stored lowercase) match a registered user's huaweiW3Id (the W3-verified
// identity — NEVER the email-derived handle, see lib/employee-directory.ts) and
// push department/lab onto that user on every create / update / import, and at
// that user's next login — deleting a directory entry never touches the user.
model EmployeeDirectory {
  id            String   @id @default(cuid())
  name          String
  // 工号：null = 未填（允许同名多行）；非空时全局唯一（Postgres 对 NULL 不判重）。
  accountNumber String?  @unique
  department    String   @default("")
  lab           String   @default("")
  avatarUrl     String   @default("")
  isActive      Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation("EmployeeEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([department])
  @@index([lab])
}

// ─── Library（知识库）──────────────────────────────────────────────────────
// Readwise-Reader-style community library: users submit a URL / PDF / EPUB;
// the server extracts it into a normalized reading carrier (chaptered
// sanitized HTML + plain-text chunks); AI reads it ONCE (cached on the rows);
// all users then share the AI 导读 + cheap retrieval Q&A. Self-contained like
// the video board: every Library* model FKs only to User or Library*.

enum LibraryDocType {
  book
  paper
  blog
  article
  report
  other
}

enum LibraryDocFormat {
  url
  pdf
  epub
  html
  pptx
  docx
}

enum LibraryDocStatus {
  pending
  processing
  ready
  failed
}

enum LibraryHighlightColor {
  yellow
  green
  blue
  pink
}

enum LibraryVisibility {
  public
  restricted
  private
}

enum LibraryCommentStatus {
  visible
  deleted
}

model LibraryDoc {
  id               String            @id @default(cuid())
  slug             String            @unique
  title            String
  author           String?
  language         String? // 'zh' | 'en' | null (heuristic)
  docType          LibraryDocType    @default(article)
  docTypePinned    Boolean           @default(false) // user/admin chose explicitly; AI never overwrites
  categories       String[]          @default([]) // fixed AI-topic taxonomy slugs (lib/library/types.ts), multi-select
  categoriesPinned Boolean           @default(false) // uploader picked; AI backfill never overwrites
  visibility       LibraryVisibility @default(public) // restricted = 申请后可读 (skills model); private = 仅上传者/管理员
  metaPinned       Boolean           @default(false) // uploader edited title/author/summary; re-extract keeps them
  format           LibraryDocFormat
  status           LibraryDocStatus  @default(pending)
  processingError  String?
  summary          String            @default("") // short description shown on cards (AI-filled)
  abstractMd       String            @default("") // 上传者撰写的摘要 Abstract — never AI-touched; shown above AI 导读
  sourceUrl        String? // canonicalized original URL (null for file uploads)
  siteName         String? // og:site_name / readable domain / null
  publishedAt      DateTime? // original publish date
  coverUrl         String? // root-relative stored cover, null => deterministic placeholder
  fileKey          String? // original pdf/epub key in storage
  fileUrl          String? // root-relative /api/library/file/<key>
  mimeType         String?
  fileSizeBytes    Int               @default(0)
  contentHash      String? // sha256 hex of original bytes (dedup anchor #2)
  wordCount        Int               @default(0) // CJK chars + latin words
  estReadMinutes   Int               @default(0)
  chapterCount     Int               @default(0)
  chunkerVersion   Int               @default(1)
  featured         Boolean           @default(false)
  featuredAt       DateTime?
  uploaderId       String
  viewCount        Int               @default(0)
  likeCount        Int               @default(0)
  shelfCount       Int               @default(0)
  commentCount     Int               @default(0)
  ratingCount      Int               @default(0)
  avgRating        Float             @default(0)

  // AI cache — generated once, shared by all users
  aiOverview     Json? // { summary: string, outline: string[], keyPoints: string[], questions: string[] }
  aiModel        String?
  aiIndexedAt    DateTime?
  aiSourceHash   String? // = contentHash at indexing time; mismatch => stale
  aiIndexState   String    @default("none") // none | running | ready | failed
  aiError        String?
  aiTokensInput  Int       @default(0)
  aiTokensOutput Int       @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  uploader       User                   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  chapters       LibraryChapter[]
  chunks         LibraryChunk[]
  shelfItems     LibraryShelfItem[]
  likes          LibraryLike[]
  progress       LibraryProgress[]
  highlights     LibraryHighlight[]
  views          LibraryView[]
  chatMessages   LibraryChatMessage[]
  comments       LibraryComment[]
  ratings        LibraryRating[]
  accessRequests LibraryAccessRequest[]

  @@index([status, deletedAt, createdAt])
  @@index([docType, status, createdAt])
  @@index([featured, featuredAt])
  @@index([uploaderId])
  @@index([contentHash])
  @@index([sourceUrl])
  @@index([shelfCount])
  @@index([viewCount])
}

model LibraryChapter {
  id           String   @id @default(cuid())
  docId        String
  chapterIndex Int
  title        String?
  html         String // sanitized reading HTML (sanitized at ingest; rendered with dangerouslySetInnerHTML)
  charCount    Int      @default(0)
  // PDF page span (0-based, inclusive) — the 原版 pdf.js view maps highlights
  // and TOC jumps between pages and chapters through these. Null for non-PDF.
  pageStart    Int?
  pageEnd      Int?
  aiSummary    String? // <=120 chars retrieval index entry; null = not yet summarized (checkpoint)
  aiKeywords   String[] @default([])

  doc LibraryDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([docId, chapterIndex])
}

model LibraryChunk {
  id            String @id @default(cuid())
  docId         String
  chapterIndex  Int
  ordinal       Int // chunkKey = `c${chapterIndex}-${ordinal}`
  text          String
  tokenEstimate Int
  charStart     Int // offsets within chapter plain text (paragraphs joined by \n\n)
  charEnd       Int

  doc LibraryDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([docId, chapterIndex, ordinal])
  @@index([docId])
}

model LibraryShelfItem {
  userId    String
  docId     String
  createdAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  doc  LibraryDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@id([userId, docId])
  @@index([docId])
  @@index([userId, createdAt])
}

model LibraryLike {
  userId    String
  docId     String
  createdAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  doc  LibraryDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@id([userId, docId])
  @@index([docId])
}

model LibraryProgress {
  userId       String
  docId        String
  chapterIndex Int      @default(0)
  scrollRatio  Float    @default(0) // 0..1 within chapter
  percent      Float    @default(0) // 0..100 whole doc
  shareNotes   Boolean  @default(false) // 公开我的划线/笔记给本文档的其他读者
  updatedAt    DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  doc  LibraryDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@id([userId, docId])
  @@index([userId, updatedAt])
}

model LibraryHighlight {
  id           String                @id @default(cuid())
  docId        String
  userId       String
  chapterIndex Int
  charStart    Int // offsets in chapter plain text (fallback ordering/position)
  charEnd      Int
  quote        String // <=300 chars, primary DOM re-anchoring key
  color        LibraryHighlightColor @default(yellow)
  noteText     String?
  replyCount   Int                   @default(0) // community replies (visible when the owner shares notes)
  createdAt    DateTime              @default(now())

  doc     LibraryDoc         @relation(fields: [docId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies LibraryNoteReply[]

  @@index([docId, userId, chapterIndex])
  @@index([userId, createdAt])
}

// Skills-style gated access for visibility=restricted docs: re-apply mutates
// the unique row back to pending; uploader or admin decides.
model LibraryAccessRequest {
  id           String              @id @default(cuid())
  docId        String
  userId       String
  status       AccessRequestStatus @default(pending)
  message      String?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  doc       LibraryDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  user      User       @relation("LibraryAccessRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?      @relation("LibraryAccessDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([docId, userId])
  @@index([docId, status])
  @@index([userId])
  @@index([decidedById])
}

// Detail-page discussion — the feedback board's 2-level flat thread contract
// (parentId = thread root; transient replyToId only in the API; tombstone when
// replies exist).
model LibraryComment {
  id         String               @id @default(cuid())
  docId      String
  authorId   String
  parentId   String?
  bodyMd     String
  status     LibraryCommentStatus @default(visible)
  replyCount Int                  @default(0)
  createdAt  DateTime             @default(now())

  doc     LibraryDoc       @relation(fields: [docId], references: [id], onDelete: Cascade)
  author  User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  LibraryComment?  @relation("LibraryCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies LibraryComment[] @relation("LibraryCommentThread")

  @@index([docId, createdAt])
  @@index([parentId])
  @@index([authorId, createdAt])
}

// 1–5 star rating, one per user per doc; avgRating/ratingCount denormalized on the doc.
model LibraryRating {
  userId    String
  docId     String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  doc  LibraryDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@id([userId, docId])
  @@index([docId])
}

// Admin-configured LLM override for 知识库 AI (indexing / chat). Single row
// (id 'default'); null fields fall back to the env-configured provider.
model LibrarySetting {
  id          String   @id @default("default")
  llmProvider String? // 'anthropic' | 'openai'
  llmBaseUrl  String?
  llmApiKey   String?
  llmModel    String?
  // Wire flags for a SELF-HOSTED OpenAI-compatible server (vLLM/SGLang) only.
  // vLLM accepts and ignores unknown request fields; api.openai.com hard-400s
  // them, so they are opt-in per deployment and never sent to Anthropic.
  // disableThinking sends chat_template_kwargs.enable_thinking=false, which is
  // the root-cause fix for a reasoning model burning its budget inside <think>.
  llmDisableThinking Boolean @default(false)
  llmJsonMode        Boolean @default(false)
  updatedAt   DateTime @updatedAt
}

// Per-user "问问这篇文档" conversation history — the reader chat panel loads
// it on open and the chat route appends both sides after each exchange.
model LibraryChatMessage {
  id        String   @id @default(cuid())
  docId     String
  userId    String
  role      String // 'user' | 'assistant'
  content   String
  citations Json? // assistant rows: [{key, chapterIndex, charStart, snippet}]
  createdAt DateTime @default(now())

  doc  LibraryDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([docId, userId, createdAt])
}

// Replies to a shared note in the reader's community sidebar (single level).
model LibraryNoteReply {
  id          String               @id @default(cuid())
  highlightId String
  authorId    String
  bodyMd      String
  status      LibraryCommentStatus @default(visible)
  createdAt   DateTime             @default(now())

  highlight LibraryHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([highlightId, createdAt])
  @@index([authorId])
}

model LibraryView {
  id          String   @id @default(cuid())
  docId       String
  userId      String?
  sessionHash String // sha256(dailySalt: (userId|ipHash) + docId + UTC day) — copy VideoView pattern
  createdAt   DateTime @default(now())

  doc  LibraryDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  user User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([docId, sessionHash])
  @@index([userId])
}

// ─── 活动（Events）─────────────────────────────────────────────────────────
// Community event calendar: member-published events — 外部活动 (conferences),
// 内部活动, 专家分享, 研讨会 — with optional speaker lineups. Self-contained
// like the video board: Event* models FK only to User or Event*.
//
// Time semantics: TIMED events store REAL UTC instants in startAt/endAt plus
// the organizer's picked IANA zone in `timezone` (fixed EVENT_TIMEZONES set in
// lib/events/types.ts); the UI converts to each viewer's local zone. ALL-DAY
// events are date-only (UTC midnight, timezone null) and never converted. Date
// filtering compiles to exact per-zone SQL branches in lib/event-queries.ts.

enum EventKind {
  external // 外部活动（学术会议 / 行业峰会 / 外部讲座）
  internal // 内部活动（团队 / 公司活动）
  expert_talk // 专家分享
  seminar // 研讨会 / workshop
}

enum EventMode {
  online // 线上
  offline // 线下
  hybrid // 线上 + 线下
}

model Event {
  id            String    @id @default(cuid())
  authorId      String
  title         String
  summary       String    @default("") // 一句话简介 shown on cards
  descriptionMd String    @default("")
  kind          EventKind
  topics        String[]  @default([]) // fixed topic taxonomy slugs (lib/events/types.ts), multi-select
  mode          EventMode @default(offline)
  startAt       DateTime // timed: real UTC instant; allDay: date-only UTC midnight
  endAt         DateTime? // optional; may be a later day (multi-day conferences)
  allDay        Boolean   @default(false) // 全天/多天活动：只显示日期，不显示时刻
  timezone      String? // IANA zone (fixed EVENT_TIMEZONES set); null for allDay / legacy = default zone
  venue         String? // 具体地点（会议室 / 场馆 / 地址）
  city          String? // 城市 — fixed EVENT_CITIES option (filter facet)
  meetingUrl    String? // 线上会议链接（WeLink / Zoom / …）
  websiteUrl    String? // 官网 / 报名链接（多用于外部会议）
  coverUrl      String? // root-relative stored cover; withBasePath at render time
  pinned        Boolean   @default(false) // admin 置顶（活动页顶部推荐位）
  cancelledAt   DateTime? // organizer/admin 取消 — kept visible with a 已取消 banner
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author   User           @relation("AuthoredEvents", fields: [authorId], references: [id], onDelete: Cascade)
  speakers EventSpeaker[]

  @@index([deletedAt, startAt])
  @@index([kind, startAt])
  @@index([pinned, startAt])
  @@index([city])
  @@index([authorId])
}

// Ordered speaker lineup (讲师/嘉宾), fully embedded in its event: rows are
// replaced wholesale on event edit (delete + recreate), never shared.
model EventSpeaker {
  id        String @id @default(cuid())
  eventId   String
  name      String
  title     String @default("") // 头衔 / 职位
  org       String @default("") // 单位 / 组织
  avatarUrl String @default("") // root-relative upload or external URL; withBasePath at render
  link      String @default("") // 个人主页 / 学术主页
  bio       String @default("")
  sortOrder Int    @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
}
